# Falls back to RETELL_API_KEY if RETELL_WEBHOOK_SECRET is empty.
RETELL_WEBHOOK_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
